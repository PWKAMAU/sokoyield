# Copy to `.env` at the repo root: `cp .env.example .env`
# NEVER commit real secrets.

# ---------- Runtime ----------
NODE_ENV=development

# ---------- PostgreSQL (relational ledger) ----------
POSTGRES_USER=sokoyield
POSTGRES_PASSWORD=sokoyield_dev_password
POSTGRES_DB=sokoyield
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sokoyield:sokoyield_dev_password@localhost:5432/sokoyield

# ---------- Redis (cache) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=sokoyield_dev_redis
REDIS_URL=redis://:sokoyield_dev_redis@localhost:6379

# ---------- Kafka (async photo-upload queue) ----------
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sokoyield-api

# ---------- API (NestJS) ----------
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000

# ---------- Web (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Third-party (populated in later phases) ----------
# PLANTIX_API_KEY=
# AGRIO_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# MAPBOX_ACCESS_TOKEN=
